{
  "name": "duckmon",
  "version": "0.1.0",
  "description": "Embedded telemetry store that writes Parquet files and queries them with DuckDB",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./opentelemetry": {
      "types": "./dist/opentelemetry/index.d.ts",
      "default": "./dist/opentelemetry/index.js"
    }
  },
  "files": [
    "dist",
    "duckmon.node"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-native.mjs && tsc",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "apache-arrow": "21.2.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
